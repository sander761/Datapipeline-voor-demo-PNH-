# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# do not upload large data files
/output/01_download/
/output/02_clip/
/output/03_build_bridges/
/output/04_spatial_relations/
/output/05_classify/
/output/06_mki/
/output/07_overzichten/
/output/08_buurten_mki/
# do not add pycache files
__pycache__/
*.pyc

